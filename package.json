{
  "name": "files-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "ci:verify": "pnpm test && pnpm run build && pnpm --dir service test && pnpm --dir service type-check && pnpm --dir service build && pnpm audit --prod --audit-level low && pnpm --dir service audit --prod --audit-level low",
    "audit:security": "pnpm audit --audit-level low && pnpm --dir service audit --audit-level low",
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "dev:service": "cd service && yarn dev",
    "watch": "npm-run-all --parallel dev dev:service",
    "build:docker": "node start.mjs",
    "dev:all": "npm-run-all --parallel dev dev:service"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.12.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.0",
    "mei-utils": "^1.0.10",
    "naive-ui": "^2.45.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "pnpm": {
    "overrides": {
      "mei-utils>axios": "^1.21.0",
      "@typescript-eslint/typescript-estree>minimatch": "^9.0.7"
    }
  }
}
